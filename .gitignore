# Documentation build files
docs/_build/
.doc/

# User-specific files
.user_config
.personal_settings
user_scripts/

# Large files and archives
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Ignore specific file patterns
*_GENERATED_*
*_AUTO_*
.generated_*

# Cache directories
.cache/
cache/
.tmp/

# Lock files (except for important ones)
*.lock
!requirements.lock
!Pipfile.lock

# Node modules (if any web components are added)
node_modules/
npm-debug.log
yarn-error.log

# Database files
*.db
*.sqlite
*.sqlite3

# Compiled binaries
*.exe
*.dll
*.so
*.dylib

# Package files
*.deb
*.rpm
*.pkg
*.dmg

# Editor backup files
*~
*.orig
*.rej

# Mac specific
.AppleDouble
.LSOverride
Icon?

# Linux specific
.fuse_hidden*
.directory
.Trash-*

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Temporary directories that tools might create
.working_dir/
.temp_analysis/
.processing/

# Keep these important files (whitelist exceptions)
!README.md
!requirements.txt
!.github/