*.report

# Backup files
backup_*/
*_backup_*/
*.backup
*.bak
pre_upgrade_app_count.txt
crd_snapshots/
crd_backups/

# Kubernetes and Helm temporary files
*.yaml.tmp
*.yml.tmp
values-*.yaml
chart-cache/
helm-cache/

# ArgoCD specific generated files
argocd-crd-backup-*/
tmp-argocd-*/

# Shell script logs and outputs
nohup.out
screen-logs.*

# Test files and mock data
test_data/
mock_*/
fixtures/

# Configuration files with sensitive data
config.local.*
.env.local
.env.*.local
secrets.yaml
private-key.*
*.pem
*.key
*.crt

# Runtime and process files
*.pid
*.seed
*.pid.lock

# Coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
